rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // 익명(게스트) 로그인이 아닌 실제 회원인지 확인
    function isRealUser() {
      return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // 호출자의 users 문서 role (문서가 없으면 '') — get() 은 규칙 평가당 1회만
    function myRole() {
      return isRealUser()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function isAdmin() {
      return myRole() in ['admin', 'superadmin'];
    }

    // 역할·칭호 변경, 관리자 계정 삭제 등은 슈퍼관리자만
    function isSuperAdmin() {
      return myRole() == 'superadmin';
    }

    function isOwner(uid) {
      return isRealUser() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 배열에서 추가·제거된 원소가 본인 uid 뿐인지 (타인 투표 삭제·대리 투표 차단)
    function onlyMeChanged(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }

    // 이벤트 투표/퀴즈/반응 — 회원은 자기 uid 에 관한 항목만 넣고 뺄 수 있다
    function validOwnVote() {
      let bv = resource.data.get('votes', {});
      let av = request.resource.data.get('votes', {});
      return av.diff(bv).affectedKeys().hasOnly(['attending', 'maybe', 'absent'])
        && onlyMeChanged(bv.get('attending', []), av.get('attending', []))
        && onlyMeChanged(bv.get('maybe', []), av.get('maybe', []))
        && onlyMeChanged(bv.get('absent', []), av.get('absent', []))
        && request.resource.data.get('quizAnswers', {}).diff(resource.data.get('quizAnswers', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {}))
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    // 댓글 수 ±1 만 허용
    function validCountStep(field) {
      return changedKeys().hasOnly([field])
        && (request.resource.data[field] == resource.data.get(field, 0) + 1
            || request.resource.data[field] == resource.data.get(field, 0) - 1);
    }

    // 재테크 댓글 작성 — 본인 명의 + 본문 길이 + 좋아요 0에서 시작.
    // isAdmin(운영진 배지)은 실제 관리자만 true 로 쓸 수 있다 (배지 위조 차단)
    function validInvestCommentCreate() {
      let d = request.resource.data;
      return isRealUser()
        && d.authorUid == request.auth.uid
        && d.body is string
        && d.body.size() > 0
        && d.body.size() <= 1000
        && d.get('likes', 0) == 0
        && d.get('likedBy', []).size() == 0
        && (d.get('isAdmin', false) == false || isAdmin());
    }

    // 좋아요 토글 — likedBy 에 본인 uid 하나만 넣거나 빼고, likes 는 정확히 ±1
    // (남의 좋아요를 지우거나 숫자를 임의로 바꾸는 것 차단)
    function validLikeToggle() {
      let before = resource.data.get('likedBy', []).toSet();
      let after = request.resource.data.get('likedBy', []).toSet();
      let me = [request.auth.uid].toSet();
      let oldLikes = resource.data.get('likes', 0);
      let newLikes = request.resource.data.get('likes', 0);
      return isRealUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        && (
             (after.difference(before) == me && before.difference(after).size() == 0
              && newLikes == oldLikes + 1)
             ||
             (before.difference(after) == me && after.difference(before).size() == 0
              && newLikes == oldLikes - 1)
           );
    }

    // ── users 컬렉션 ────────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 본인 문서 생성 가능 (role은 반드시 'member', 게스트 불가)
    // - 본인은 name·lastSeen·lastLocation 만 변경 가능 (role·title 등은 관리자만)
    // - 삭제는 본인(탈퇴) 또는 관리자(강퇴)
    match /users/{uid} {
      allow read: if isAuth();
      // 본인 가입: role 은 member, 이메일은 로그인 토큰과 일치, 칭호(title) 등 다른 필드 금지
      allow create: if (isOwner(uid)
          && request.resource.data.role == 'member'
          && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
          && request.resource.data.email is string
          && request.resource.data.email.lower() == request.auth.token.email.lower())
        // 관리자가 만드는 계정(createAccount): admin 부여는 슈퍼관리자만
        || (isAdmin()
          && (request.resource.data.role == 'member'
              || (isSuperAdmin() && request.resource.data.role == 'admin')));
      allow update: if
        // 슈퍼관리자: 전부 가능. 단 자기 role 은 못 바꿈(실수로 마지막 슈퍼관리자가 사라지는 것 방지)
        (isSuperAdmin() && !(request.auth.uid == uid && changedKeys().hasAny(['role'])))
        // 일반 관리자: role·title 은 못 건드리고, 슈퍼관리자 문서는 수정 불가 (스스로 승격·슈퍼관리자 강등 차단)
        || (isAdmin() && resource.data.get('role', '') != 'superadmin'
            && !changedKeys().hasAny(['role', 'title']))
        || (isOwner(uid) && changedKeys().hasOnly(['name', 'lastSeen', 'lastLocation']));
      // 삭제: 본인(탈퇴) / 슈퍼관리자(자기 자신 제외) / 일반 관리자는 member 만 강퇴
      allow delete: if isOwner(uid)
        || (isSuperAdmin() && request.auth.uid != uid)
        || (isAdmin() && resource.data.get('role', '') == 'member');
    }

    // ── members 컬렉션 ──────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 본인 프로필 생성 가능 (게스트 불가)
    // - 수정은 본인 또는 관리자
    // - 삭제는 본인(탈퇴 시 자기 데이터 정리) 또는 관리자(강퇴 시 정리)
    match /members/{memberId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid
            && !changedKeys().hasAny(['createdBy']));
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);
    }

    // ── events 컬렉션 ───────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 생성은 실제 회원만 가능 (게스트 불가)
    // - 수정: 관리자 / 작성자 본인 / 투표 필드(votes·quizAnswers)만 변경하는 경우
    // - 삭제: 관리자 또는 작성자 본인
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid)
        || (isRealUser()
            && changedKeys().hasOnly(['votes', 'quizAnswers', 'reactions'])
            && validOwnVote());
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);

      // 댓글 서브컬렉션 (gallery 댓글과 같은 규칙)
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isRealUser()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isRealUser()
          && resource.data.authorUid == request.auth.uid;
        allow delete: if isRealUser()
          && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // ── notices 컬렉션 ──────────────────────────────────────
    // - 인증된 유저 읽기, 관리자만 쓰기
    match /notices/{noticeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── gallery 컬렉션 ──────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 생성·수정은 관리자만
    // - 삭제: 관리자 또는 작성자 본인 (탈퇴 시 자기 데이터 정리)
    match /gallery/{galleryId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);

      // 댓글 서브컬렉션
      // - 인증된 유저(게스트 포함) 읽기
      // - 작성·수정·삭제는 실제 회원만
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isRealUser()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isRealUser()
          && resource.data.authorUid == request.auth.uid;
        allow delete: if isRealUser()
          && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // ── dms 컬렉션 ──────────────────────────────────────────
    // - 참여자만 읽기/쓰기 가능 (게스트 불가)
    match /dms/{convId} {
      allow read: if isRealUser()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isRealUser()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2;
      // 참여자 목록은 생성 후 불변 (제3자 끼워넣기 차단)
      allow update: if isRealUser()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isRealUser()
        && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if isRealUser()
          && request.auth.uid in
            get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        allow create: if isRealUser()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        // 메시지 삭제는 보낸 사람 본인 또는 관리자만 (상대 메시지 삭제 차단)
        allow delete: if isRealUser()
          && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // ── anon_posts 컬렉션 (익명 게시판) ────────────────────────
    // - 실제 회원만 읽기/작성
    // - 좋아요(likes, likedBy) 업데이트는 실제 회원
    // - 삭제는 관리자만
    match /anon_posts/{postId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        // 작성자: 본문·제목·사진 등은 수정 가능, 작성자·좋아요·댓글수·작성일은 못 건드림
        || (isRealUser() && resource.data.createdBy == request.auth.uid
            && !changedKeys().hasAny(['createdBy', 'likes', 'likedBy', 'commentCount', 'createdAt']))
        // 좋아요: 본인 uid 하나만 넣고/빼고 likes 는 정확히 ±1
        || validLikeToggle()
        // 댓글 수: ±1 만
        || (isRealUser() && validCountStep('commentCount'));
      // 삭제: 관리자 또는 작성자 본인 (UI 의 삭제 버튼과 일치)
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isRealUser();
        allow create: if isRealUser()
          && request.resource.data.createdBy == request.auth.uid;
        // 삭제: 관리자 / 댓글 작성자 / 글 작성자(글 삭제 시 댓글 일괄 정리)
        allow delete: if isAdmin()
          || (isRealUser() && resource.data.createdBy == request.auth.uid)
          || (isRealUser()
              && get(/databases/$(database)/documents/anon_posts/$(postId)).data.createdBy == request.auth.uid);
      }
    }

    // ── blacklist 컬렉션 ─────────────────────────────────────
    // - 가입 화면은 자동 게스트(익명) 세션 위에서 동작하므로 인증 세션이면 읽기 허용
    //   (완전 비인증 크롤러가 강퇴 이메일 목록을 긁어가는 것 차단)
    // - 쓰기(추가·삭제)는 관리자만
    match /blacklist/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── game_scores 컬렉션 (미니게임 랭킹) ──────────────────
    // - 모든 사용자 읽기 가능 (랭킹 조회)
    // - 실제 회원만 자기 점수 생성/수정, 점수는 0~1,000,000 정수·이름 30자 이내
    function validGameScore() {
      return request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
    }
    match /game_scores/{uid} {
      allow read: if true;
      allow create: if isRealUser() && request.auth.uid == uid && validGameScore();
      allow update: if isRealUser() && request.auth.uid == uid && validGameScore();
    }

    // ── config 컬렉션 (사이트 설정) ────────────────────────────
    // - 모든 사용자 읽기 가능 (챗봇 터널 URL 등)
    // - 관리자만 수정
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── youtube_channels 컬렉션 (YouTube 채널 관리) ──────────
    // - 모든 사용자 읽기 가능 (홈 영상 표시)
    // - 관리자만 추가/삭제
    match /youtube_channels/{channelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── ai_trend_links 컬렉션 (AI 트렌드 링크) ──────────────
    // - 모든 사용자 읽기 가능
    // - 관리자만 추가/삭제
    match /ai_trend_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── ai_trend_posts 컬렉션 (AI 브리핑 게시글) ─────────────
    // - 누구나 읽기 가능
    // - 관리자만 작성/삭제
    match /ai_trend_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── car_trend_posts 컬렉션 (자동차 브리핑 게시글) ─────────
    // - 누구나 읽기 가능
    // - 관리자만 작성/삭제
    match /car_trend_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── car_trend_links 컬렉션 (자동차 트렌드 링크) ──────────
    // - 모든 사용자 읽기 가능
    // - 관리자만 추가/삭제
    match /car_trend_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── spots 컬렉션 (DT 스팟 — 장소) ──────────────────────
    // - 누구나 읽기 가능 (비회원 포함)
    // - 실제 회원이면 등록 가능
    // - 수정·삭제는 관리자만
    match /spots/{spotId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── guide_data 컬렉션 (드라이브 가이드 데이터) ──────────────
    // - 누구나 읽기 가능 (비회원용 컨텐츠)
    // - 관리자만 수정 가능
    match /guide_data/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── course_data 컬렉션 (드라이브 코스 가이드 데이터) ─────────
    // - 누구나 읽기 가능 (비회원용 컨텐츠)
    // - 관리자만 수정 가능
    match /course_data/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── course_posts 컬렉션 (드라이브 코스 게시글) ───────────────
    // - 누구나 읽기 가능
    // - 실제 회원이면 작성 가능
    // - 수정·삭제는 관리자 또는 작성자 본인
    match /course_posts/{postId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid);
    }

    // ── car_costs 컬렉션 (차량 유지비) ────────────────────────
    // - 본인 데이터만 읽기/쓰기 가능
    match /car_costs/{costId} {
      allow create: if isRealUser()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ── legal_chats 컬렉션 (법률 상담 이력) ────────────────
    // - 본인 상담 이력만 읽기/쓰기 가능
    match /legal_chats/{chatId} {
      allow create: if isRealUser()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ── legal_usage 컬렉션 (AI 법률 도우미 토큰 사용량/비용) ──
    // - 서버(Service Account)만 write (Firebase Admin SDK 경로)
    // - 본인 사용량만 read, 관리자는 전체 read
    match /legal_usage/{docId} {
      allow create: if false;  // 서버만 (Service Account bypass)
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // ── legal_rate_limits 컬렉션 (분단위 요청 카운터) ─────
    // - 서버(Service Account)만 write/read (Firebase Admin SDK 경로)
    // - 일반 유저 접근 차단
    match /legal_rate_limits/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;  // 서버만
    }

    // ── drive_courses 컬렉션 (DT 스팟 — 드라이브 코스) ──────
    // - 누구나 읽기 가능 (비회원 포함)
    // - 실제 회원이면 등록 가능
    // - 수정(경로 캐시 포함)·삭제는 관리자 또는 작성자
    match /drive_courses/{courseId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.addedBy == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.addedBy == request.auth.uid);
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.addedBy == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════════
    //  재테크 (DT Invest) — 폐쇄형 회원 전용
    //  원칙: update 시 반드시 필드 화이트리스트를 건다
    // ══════════════════════════════════════════════════════════

    // ── invest_briefings 컬렉션 (관리자 시황 브리핑) ──────────
    // - 실제 회원만 읽기 (게스트·비회원 차단)
    // - 작성·수정·삭제는 관리자
    // - 회원은 commentCount만, 그것도 ±1 로만 변경 가능 (댓글 작성/삭제 시)
    match /invest_briefings/{briefingId} {
      allow read: if isRealUser();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isRealUser()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1));

      // 브리핑 댓글 (1단계 대댓글 지원)
      match /comments/{commentId} {
        allow read: if isRealUser();
        allow create: if validInvestCommentCreate();
        // 본인 댓글은 본문만 수정 가능 (authorUid·isAdmin 등을 못 바꾸게 화이트리스트),
        // 그 외에는 좋아요 토글만 — 본인이 자기 댓글에 좋아요를 누르는 것도 이 경로
        allow update: if isRealUser()
          && (
               (resource.data.authorUid == request.auth.uid
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['body', 'editedAt'])
                && request.resource.data.body is string
                && request.resource.data.body.size() > 0
                && request.resource.data.body.size() <= 1000)
               || validLikeToggle()
             );
        allow delete: if isAdmin()
          || (isRealUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ── stock_boards 컬렉션 (종목별 커뮤니티) ─────────────────
    // - 실제 회원만 읽기/작성
    // - 본인 글은 제목·본문만 수정 (authorUid·isAdmin·좋아요 수를 못 바꾸게 화이트리스트)
    // - 남의 글은 좋아요 토글, 댓글수·신고수 ±1 만 가능 (임의 값으로 덮어쓰기 차단)
    match /stock_boards/{code}/posts/{postId} {
      allow read: if isRealUser();
      allow create: if isRealUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 3000
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('likedBy', []).size() == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.get('reportCount', 0) == 0
        && (request.resource.data.get('isAdmin', false) == false || isAdmin());
      allow update: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['title', 'body', 'editedAt'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 3000)
        || validLikeToggle()
        || (isRealUser()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
        // 신고수 +1 은 같은 배치에서 stock_reports/{postId_uid} 를 새로 만들 때만 — 회원당 글 하나에 신고 한 번
        || (isRealUser()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['reportCount'])
            && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
            && !exists(/databases/$(database)/documents/stock_reports/$(postId + '_' + request.auth.uid))
            && existsAfter(/databases/$(database)/documents/stock_reports/$(postId + '_' + request.auth.uid)));
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isRealUser();
        allow create: if validInvestCommentCreate();
        // 본인 댓글은 본문만 수정 가능 (authorUid·isAdmin 등을 못 바꾸게 화이트리스트),
        // 그 외에는 좋아요 토글만 — 본인이 자기 댓글에 좋아요를 누르는 것도 이 경로
        allow update: if isRealUser()
          && (
               (resource.data.authorUid == request.auth.uid
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['body', 'editedAt'])
                && request.resource.data.body is string
                && request.resource.data.body.size() > 0
                && request.resource.data.body.size() <= 1000)
               || validLikeToggle()
             );
        allow delete: if isAdmin()
          || (isRealUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ── stock_watchlist 컬렉션 (내 관심종목) ──────────────────
    // - 본인 것만 읽기/쓰기 (관리자는 열람만), 최대 50종목 (클라이언트 WATCHLIST_MAX 와 동일)
    match /stock_watchlist/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.data.get('codes', []) is list
        && request.resource.data.get('codes', []).size() <= 50;
    }

    // ── stock_reports 컬렉션 (게시글 신고) ────────────────────
    // - 접수는 실제 회원, 문서 ID 는 {postId}_{uid} 로 고정 → 같은 글을 두 번 신고할 수 없다
    // - 열람·처리(status 변경)는 관리자만
    match /stock_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isRealUser()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() <= 200;
      allow update, delete: if isAdmin();
    }

    // ── invest_config 컬렉션 (재테크 설정·면책·상시구독 종목) ──
    // - 실제 회원 읽기, 관리자만 수정
    match /invest_config/{docId} {
      allow read: if isRealUser();
      allow write: if isAdmin();
    }

  }
}
