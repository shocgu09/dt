rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // 익명(게스트) 로그인이 아닌 실제 회원인지 확인
    function isRealUser() {
      return isAuth() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isRealUser() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
    }

    function isOwner(uid) {
      return isRealUser() && request.auth.uid == uid;
    }

    // 재테크 댓글 작성 — 본인 명의 + 본문 길이 + 좋아요 0에서 시작.
    // isAdmin(운영진 배지)은 실제 관리자만 true 로 쓸 수 있다 (배지 위조 차단)
    function validInvestCommentCreate() {
      let d = request.resource.data;
      return isRealUser()
        && d.authorUid == request.auth.uid
        && d.body is string
        && d.body.size() > 0
        && d.body.size() <= 1000
        && d.get('likes', 0) == 0
        && d.get('likedBy', []).size() == 0
        && (d.get('isAdmin', false) == false || isAdmin());
    }

    // 좋아요 토글 — likedBy 에 본인 uid 하나만 넣거나 빼고, likes 는 정확히 ±1
    // (남의 좋아요를 지우거나 숫자를 임의로 바꾸는 것 차단)
    function validLikeToggle() {
      let before = resource.data.get('likedBy', []).toSet();
      let after = request.resource.data.get('likedBy', []).toSet();
      let me = [request.auth.uid].toSet();
      let oldLikes = resource.data.get('likes', 0);
      let newLikes = request.resource.data.get('likes', 0);
      return isRealUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        && (
             (after.difference(before) == me && before.difference(after).size() == 0
              && newLikes == oldLikes + 1)
             ||
             (before.difference(after) == me && after.difference(before).size() == 0
              && newLikes == oldLikes - 1)
           );
    }

    // ── users 컬렉션 ────────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 본인 문서 생성 가능 (role은 반드시 'member', 게스트 불가)
    // - 본인은 name·lastSeen·lastLocation 만 변경 가능 (role·title 등은 관리자만)
    // - 삭제는 본인(탈퇴) 또는 관리자(강퇴)
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'member';
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['name', 'lastSeen', 'lastLocation']));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── members 컬렉션 ──────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 본인 프로필 생성 가능 (게스트 불가)
    // - 수정은 본인 또는 관리자
    // - 삭제는 본인(탈퇴 시 자기 데이터 정리) 또는 관리자(강퇴 시 정리)
    match /members/{memberId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);
    }

    // ── events 컬렉션 ───────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 생성은 실제 회원만 가능 (게스트 불가)
    // - 수정: 관리자 / 작성자 본인 / 투표 필드(votes·quizAnswers)만 변경하는 경우
    // - 삭제: 관리자 또는 작성자 본인
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid)
        || (isRealUser()
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['votes', 'quizAnswers', 'reactions']));
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);

      // 댓글 서브컬렉션 (gallery 댓글과 같은 규칙)
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isRealUser()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isRealUser()
          && resource.data.authorUid == request.auth.uid;
        allow delete: if isRealUser()
          && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // ── notices 컬렉션 ──────────────────────────────────────
    // - 인증된 유저 읽기, 관리자만 쓰기
    match /notices/{noticeId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── gallery 컬렉션 ──────────────────────────────────────
    // - 인증된 유저(게스트 포함) 읽기
    // - 생성·수정은 관리자만
    // - 삭제: 관리자 또는 작성자 본인 (탈퇴 시 자기 데이터 정리)
    match /gallery/{galleryId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid);

      // 댓글 서브컬렉션
      // - 인증된 유저(게스트 포함) 읽기
      // - 작성·수정·삭제는 실제 회원만
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isRealUser()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isRealUser()
          && resource.data.authorUid == request.auth.uid;
        allow delete: if isRealUser()
          && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // ── dms 컬렉션 ──────────────────────────────────────────
    // - 참여자만 읽기/쓰기 가능 (게스트 불가)
    match /dms/{convId} {
      allow read: if isRealUser()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isRealUser()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2;
      allow update: if isRealUser()
        && request.auth.uid in resource.data.participants;
      allow delete: if isRealUser()
        && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if isRealUser()
          && request.auth.uid in
            get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        allow create: if isRealUser()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        allow delete: if isRealUser()
          && request.auth.uid in
            get(/databases/$(database)/documents/dms/$(convId)).data.participants;
      }
    }

    // ── anon_posts 컬렉션 (익명 게시판) ────────────────────────
    // - 실제 회원만 읽기/작성
    // - 좋아요(likes, likedBy) 업데이트는 실제 회원
    // - 삭제는 관리자만
    match /anon_posts/{postId} {
      allow read: if isAuth();
      allow create: if isRealUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.createdBy == request.auth.uid)
        || (isRealUser() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likes', 'likedBy', 'commentCount']));
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isRealUser();
        allow create: if isRealUser()
          && request.resource.data.createdBy == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // ── blacklist 컬렉션 ─────────────────────────────────────
    // - 회원가입 시 이메일 체크는 비인증 상태에서도 필요하므로 read는 전체 허용
    // - 쓰기(추가·삭제)는 관리자만
    match /blacklist/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── game_scores 컬렉션 (미니게임 랭킹) ──────────────────
    // - 모든 사용자 읽기 가능 (랭킹 조회)
    // - 실제 회원만 자기 점수 생성/수정
    match /game_scores/{uid} {
      allow read: if true;
      allow create: if isRealUser() && request.auth.uid == uid;
      allow update: if isRealUser() && request.auth.uid == uid;
    }

    // ── config 컬렉션 (사이트 설정) ────────────────────────────
    // - 모든 사용자 읽기 가능 (챗봇 터널 URL 등)
    // - 관리자만 수정
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── youtube_channels 컬렉션 (YouTube 채널 관리) ──────────
    // - 모든 사용자 읽기 가능 (홈 영상 표시)
    // - 관리자만 추가/삭제
    match /youtube_channels/{channelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── ai_trend_links 컬렉션 (AI 트렌드 링크) ──────────────
    // - 모든 사용자 읽기 가능
    // - 관리자만 추가/삭제
    match /ai_trend_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── ai_trend_posts 컬렉션 (AI 브리핑 게시글) ─────────────
    // - 누구나 읽기 가능
    // - 관리자만 작성/삭제
    match /ai_trend_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── car_trend_posts 컬렉션 (자동차 브리핑 게시글) ─────────
    // - 누구나 읽기 가능
    // - 관리자만 작성/삭제
    match /car_trend_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── car_trend_links 컬렉션 (자동차 트렌드 링크) ──────────
    // - 모든 사용자 읽기 가능
    // - 관리자만 추가/삭제
    match /car_trend_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── spots 컬렉션 (DT 스팟 — 장소) ──────────────────────
    // - 누구나 읽기 가능 (비회원 포함)
    // - 실제 회원이면 등록 가능
    // - 수정·삭제는 관리자만
    match /spots/{spotId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── guide_data 컬렉션 (드라이브 가이드 데이터) ──────────────
    // - 누구나 읽기 가능 (비회원용 컨텐츠)
    // - 관리자만 수정 가능
    match /guide_data/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── course_data 컬렉션 (드라이브 코스 가이드 데이터) ─────────
    // - 누구나 읽기 가능 (비회원용 컨텐츠)
    // - 관리자만 수정 가능
    match /course_data/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── course_posts 컬렉션 (드라이브 코스 게시글) ───────────────
    // - 누구나 읽기 가능
    // - 실제 회원이면 작성 가능
    // - 수정·삭제는 관리자 또는 작성자 본인
    match /course_posts/{postId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid);
    }

    // ── car_costs 컬렉션 (차량 유지비) ────────────────────────
    // - 본인 데이터만 읽기/쓰기 가능
    match /car_costs/{costId} {
      allow create: if isRealUser()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ── legal_chats 컬렉션 (법률 상담 이력) ────────────────
    // - 본인 상담 이력만 읽기/쓰기 가능
    match /legal_chats/{chatId} {
      allow create: if isRealUser()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ── legal_usage 컬렉션 (AI 법률 도우미 토큰 사용량/비용) ──
    // - 서버(Service Account)만 write (Firebase Admin SDK 경로)
    // - 본인 사용량만 read, 관리자는 전체 read
    match /legal_usage/{docId} {
      allow create: if false;  // 서버만 (Service Account bypass)
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // ── legal_rate_limits 컬렉션 (분단위 요청 카운터) ─────
    // - 서버(Service Account)만 write/read (Firebase Admin SDK 경로)
    // - 일반 유저 접근 차단
    match /legal_rate_limits/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;  // 서버만
    }

    // ── drive_courses 컬렉션 (DT 스팟 — 드라이브 코스) ──────
    // - 누구나 읽기 가능 (비회원 포함)
    // - 실제 회원이면 등록 가능
    // - 수정(경로 캐시 포함)·삭제는 관리자 또는 작성자
    match /drive_courses/{courseId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.addedBy == request.auth.uid;
      allow update: if isAdmin()
        || (isRealUser() && resource.data.addedBy == request.auth.uid);
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.addedBy == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════════
    //  재테크 (DT Invest) — 폐쇄형 회원 전용
    //  원칙: update 시 반드시 필드 화이트리스트를 건다
    // ══════════════════════════════════════════════════════════

    // ── invest_briefings 컬렉션 (관리자 시황 브리핑) ──────────
    // - 실제 회원만 읽기 (게스트·비회원 차단)
    // - 작성·수정·삭제는 관리자
    // - 회원은 commentCount만, 그것도 ±1 로만 변경 가능 (댓글 작성/삭제 시)
    match /invest_briefings/{briefingId} {
      allow read: if isRealUser();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isRealUser()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1));

      // 브리핑 댓글 (1단계 대댓글 지원)
      match /comments/{commentId} {
        allow read: if isRealUser();
        allow create: if validInvestCommentCreate();
        // 본인 댓글은 본문만 수정 가능 (authorUid·isAdmin 등을 못 바꾸게 화이트리스트),
        // 그 외에는 좋아요 토글만 — 본인이 자기 댓글에 좋아요를 누르는 것도 이 경로
        allow update: if isRealUser()
          && (
               (resource.data.authorUid == request.auth.uid
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['body', 'editedAt'])
                && request.resource.data.body is string
                && request.resource.data.body.size() > 0
                && request.resource.data.body.size() <= 1000)
               || validLikeToggle()
             );
        allow delete: if isAdmin()
          || (isRealUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ── stock_boards 컬렉션 (종목별 커뮤니티) ─────────────────
    // - 실제 회원만 읽기/작성
    // - 본인 글은 제목·본문만 수정 (authorUid·isAdmin·좋아요 수를 못 바꾸게 화이트리스트)
    // - 남의 글은 좋아요 토글, 댓글수·신고수 ±1 만 가능 (임의 값으로 덮어쓰기 차단)
    match /stock_boards/{code}/posts/{postId} {
      allow read: if isRealUser();
      allow create: if isRealUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 3000
        && request.resource.data.get('likes', 0) == 0
        && request.resource.data.get('likedBy', []).size() == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.get('reportCount', 0) == 0
        && (request.resource.data.get('isAdmin', false) == false || isAdmin());
      allow update: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['title', 'body', 'editedAt'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 3000)
        || validLikeToggle()
        || (isRealUser()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1))
        || (isRealUser()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['reportCount'])
            && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1);
      allow delete: if isAdmin()
        || (isRealUser() && resource.data.authorUid == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isRealUser();
        allow create: if validInvestCommentCreate();
        // 본인 댓글은 본문만 수정 가능 (authorUid·isAdmin 등을 못 바꾸게 화이트리스트),
        // 그 외에는 좋아요 토글만 — 본인이 자기 댓글에 좋아요를 누르는 것도 이 경로
        allow update: if isRealUser()
          && (
               (resource.data.authorUid == request.auth.uid
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['body', 'editedAt'])
                && request.resource.data.body is string
                && request.resource.data.body.size() > 0
                && request.resource.data.body.size() <= 1000)
               || validLikeToggle()
             );
        allow delete: if isAdmin()
          || (isRealUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    // ── stock_watchlist 컬렉션 (내 관심종목) ──────────────────
    // - 본인 것만 읽기/쓰기 (관리자는 열람만)
    match /stock_watchlist/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // ── stock_reports 컬렉션 (게시글 신고) ────────────────────
    // - 접수는 실제 회원, 열람·처리는 관리자만
    match /stock_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isRealUser()
        && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── invest_config 컬렉션 (재테크 설정·면책·상시구독 종목) ──
    // - 실제 회원 읽기, 관리자만 수정
    match /invest_config/{docId} {
      allow read: if isRealUser();
      allow write: if isAdmin();
    }

  }
}
